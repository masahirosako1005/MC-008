{
  "name": "nnishi-machiquest",
  "private": true,
  "version": "0.1.0",
  "description": "N西市 再訪促進スマホWebアプリ「まちクエ」（街がクエストの場所。通うほど、自分だけの街が育つ）",
  "type": "module",
  "scripts": {
    "dev": "vite --mode demo",
    "build": "tsc --noEmit && vite build",
    "build:demo": "tsc --noEmit && vite build --mode demo --outDir dist-demo",
    "preview": "vite preview",
    "preview:demo": "vite preview --mode demo --outDir dist-demo",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "audit:static": "node scripts/audit/static-audit.mjs",
    "check": "tsc --noEmit && node scripts/audit/static-audit.mjs && vitest run",
    "master:build": "node scripts/master/build-master.mjs",
    "master:check": "node scripts/master/check-master.mjs",
    "master:hash": "node scripts/master/hash-master.mjs",
    "e2e": "node scripts/e2e/demo-scenario.mjs",
    "server:build": "vite build -c vite.server.config.ts --mode demo",
    "server:build:prod": "vite build -c vite.server.config.ts",
    "build:cms": "vite build --mode cms --outDir dist-cms --emptyOutDir",
    "build:backend": "node scripts/build/backend.mjs",
    "dev:backend": "node scripts/dev/backend.mjs dev",
    "demo:backend": "node scripts/dev/backend.mjs serve",
    "e2e:backend": "node scripts/e2e/cms-backend.mjs",
    "serve:app-local": "node scripts/dev/app-local.mjs",
    "demo:fresh": "node scripts/dev/demo-fresh.mjs"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "playwright-core": "^1.65.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@fontsource/line-seed-jp": "^5.3.2",
    "pg": "^8.23.1"
  }
}
